{
  "name": "hermes",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "lucide-react": "^1.57.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "convex": "^1.46.0",
      "@workos/authkit-tanstack-react-start": "^0.11.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
      "vite-plus": "1.2.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:web": "vp run --filter web dev",
    "dev:server": "vp run --filter @hermes/backend dev",
    "dev:setup": "vp run --filter @hermes/backend dev:setup",
    "codegen": "vp run --filter @hermes/backend codegen",
    "build": "vp run -r build",
    "check": "vp check",
    "fix": "vp check --fix",
    "deploy": "vp run --filter web deploy"
  },
  "dependencies": {
    "@hermes/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@hermes/config": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
