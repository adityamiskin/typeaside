{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "hermes-releases" }],
  "vars": {
    "VITE_CONVEX_URL": "https://doting-rhinoceros-418.convex.cloud",
    "WORKOS_REDIRECT_URI": "https://hermes.adityamiskin98.workers.dev/api/auth/callback",
  },
}
