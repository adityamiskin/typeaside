{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typeaside",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "typeaside.app", "custom_domain": true }],
  "preview_urls": false,
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "typeaside-releases" }],
}
