# Optional for public pages. Copy your local Convex URL here for account features.
VITE_CONVEX_URL=http://127.0.0.1:3210

# WorkOS AuthKit. Leave unset for public-page development without credentials.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:3001/api/auth/callback
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
