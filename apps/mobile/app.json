{
  "expo": {
    "name": "TypeAside",
    "slug": "typeaside",
    "owner": "adityamiskin",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "app.typeaside",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "app.typeaside",
      "icon": "./assets/icon.icon",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.typeaside"]
      },
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "app.typeaside",
      "adaptiveIcon": {
        "backgroundColor": "#F9F9F8",
        "foregroundImage": "./assets/android-foreground.png",
        "monochromeImage": "./assets/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash.png",
          "imageWidth": 88
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "TypeAside uses the microphone to turn your speech into text.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-web-browser",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f0803f0e-7263-464e-aa0e-845934a349d1"
      }
    }
  }
}
