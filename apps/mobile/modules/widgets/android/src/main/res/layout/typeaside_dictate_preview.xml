<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
  android:gravity="center_vertical" android:paddingHorizontal="20dp" android:background="@drawable/typeaside_widget_primary">
  <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/typeaside_widget_mic"
    android:tint="@color/typeaside_widget_on_primary" android:contentDescription="@string/typeaside_dictate_widget"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
    android:text="@string/typeaside_dictate_widget" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:maxLines="1"
    android:textColor="@color/typeaside_widget_on_primary"/>
</LinearLayout>
