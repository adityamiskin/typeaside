<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
  android:background="@drawable/typeaside_widget_surface" android:padding="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="4dp"
      android:text="@string/typeaside_notes_widget" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="@color/typeaside_widget_on_surface"/>
    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/typeaside_widget_mic"
      android:background="@drawable/typeaside_widget_circle" android:backgroundTint="@color/typeaside_widget_secondary"
      android:tint="@color/typeaside_widget_on_secondary" android:contentDescription="@string/typeaside_dictate_widget"/>
    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:padding="9dp" android:src="@drawable/typeaside_widget_add"
      android:background="@drawable/typeaside_widget_circle" android:backgroundTint="@color/typeaside_widget_primary"
      android:tint="@color/typeaside_widget_on_primary" android:contentDescription="New note"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginTop="8dp">
    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/typeaside_widget_note" android:tint="@color/typeaside_widget_on_variant"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="No notes yet" android:textSize="14sp" android:textColor="@color/typeaside_widget_on_variant"/>
    <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="12dp" android:paddingHorizontal="20dp" android:gravity="center"
      android:text="New note" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/typeaside_widget_on_secondary" android:background="@drawable/typeaside_widget_tonal_button"/>
  </LinearLayout>
</LinearLayout>
