{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typeaside-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.typeaside.app", "custom_domain": true }],
  "vars": { "CONVEX_SITE_URL": "https://doting-rhinoceros-418.convex.site" },
  "ratelimits": [
    { "name": "DICTATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  "env": {
    "dev": {
      "name": "typeaside-api-dev",
      "workers_dev": true,
      "routes": [],
      "vars": { "CONVEX_SITE_URL": "https://tangible-ferret-27.convex.site" },
      "ratelimits": [
        {
          "name": "DICTATE_LIMIT",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
    },
  },
}
