# Local anonymous setup writes .env.local. Do not create a cloud deployment.
# CONVEX_AGENT_MODE=anonymous bunx convex dev --once
# CONVEX_URL=http://127.0.0.1:3210
# CONVEX_SITE_URL=http://127.0.0.1:3211

# Set backend values with `bunx convex env set NAME value` against your dev deployment.
# Convex functions do not load this example file.
WORKOS_CLIENT_ID=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PRO_MONTHLY_PRODUCT_ID=
DODO_PRO_YEARLY_PRODUCT_ID=
